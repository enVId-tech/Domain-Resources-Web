{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-resources-web",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./out",
    // next build writes out/404.html (from app/not-found.tsx); serve it with a 404 status for any miss.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
