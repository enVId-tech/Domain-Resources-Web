{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-resources-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Run the Worker for every request so it can check the origin before serving anything.
    "run_worker_first": true,
    // next build writes out/404.html (from app/not-found.tsx).
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Put the Worker in front of the whole domain. These are Routes, not a Custom Domain: a Worker can't
  // use its own hostname as the origin. Remove "routes" to deploy only to <name>.<account>.workers.dev
  // (which always previews the down page and touches no real traffic).
  "routes": [
    { "pattern": "etran.dev/*", "zone_name": "etran.dev" },
    { "pattern": "*.etran.dev/*", "zone_name": "etran.dev" }
  ]
}
